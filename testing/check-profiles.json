{
  "schemaVersion": 1,
  "groups": {
    "client-components": {
      "label": "Client behavior tests",
      "command": "npm",
      "args": ["--prefix", "client", "test"],
      "cwd": ".",
      "timeoutMs": 120000,
      "why": "Protects visible client behavior without live services.",
      "capabilities": ["qbo-evidence-intake", "image-parse-validation", "unsaved-result-protection", "saved-session-resume", "evidence-completeness", "qbo-orchestration", "conversation-persistence", "escalation-lifecycle", "qbo-case-realtime-continuity", "global-live-work-attention", "ticket-snitch-user-reporting", "workspace-primary-operations-agent", "agent-execution-safety", "provider-controls", "request-diagnostics"]
    },
    "server-suite": {
      "label": "Server behavior tests",
      "command": "node",
      "args": ["server/scripts/run-tests.js", "--continue"],
      "resultContract": "server-tests",
      "cwd": ".",
      "timeoutMs": 1800000,
      "why": "Checks persistence, permissions, evidence, and route contracts.",
      "capabilities": ["qbo-evidence-intake", "image-parse-validation", "qbo-orchestration", "conversation-persistence", "unsaved-result-protection", "saved-session-resume", "evidence-completeness", "escalation-lifecycle", "qbo-case-realtime-continuity", "global-live-work-attention", "ticket-snitch-user-reporting", "shared-agent-tool-authority", "workspace-primary-operations-agent", "agent-execution-safety"]
    },
    "stress-harness-tests": {
      "label": "Stress harness infrastructure tests",
      "command": "node",
      "args": ["--test", "stress-testing/scripts/test/*.test.js"],
      "cwd": ".",
      "timeoutMs": 120000,
      "why": "Checks isolation gates, baselines, and controlled service stubs.",
      "capabilities": ["qbo-evidence-intake", "image-parse-validation", "qbo-orchestration"]
    },
    "runner-contracts": {
      "label": "Complete-check runner contract tests",
      "command": "node",
      "args": ["--test", "scripts/test/run-app-checks.test.js", "scripts/test/validate-testing-map.test.js", "stress-testing/scripts/test/run-slices-summary.test.js", "server/test/server-test-runner.test.js"],
      "cwd": ".",
      "timeoutMs": 120000,
      "why": "Proves passed, failed, and incomplete cannot be confused.",
      "capabilities": ["evidence-completeness"]
    },
    "dev-startup": {
      "label": "Friendly development startup contracts",
      "command": "node",
      "args": ["--test", "scripts/dev-launcher.test.js", "server/test/startup-console.test.js", "server/test/service-health-status.test.js", "server/test/knowledgebase-agent-scheduler.test.js"],
      "cwd": ".",
      "timeoutMs": 30000,
      "why": "Checks startup messaging, code identity, core-before-background ordering, safe transient retry, precise recovery guidance, quiet and browser-open modes, WebSocket and event-stream health, evidence-store reporting, and honest per-service shutdown without controlling persistent services.",
      "capabilities": ["development-startup-safety", "investments-questrade-stage-1", "investments-questrade-stage-2"]
    },
    "investments-server": {
      "label": "Investments server and security boundaries",
      "command": "node",
      "args": ["server/scripts/run-tests.js", "--continue", "test/investments/security-boundaries.test.js", "test/investments/connection-routes.test.js", "test/investments/stage2-connection.test.js", "test/realtime-websocket.test.js", "test/live-call-assist-websocket.test.js"],
      "resultContract": "server-tests",
      "cwd": ".",
      "timeoutMs": 120000,
      "why": "Checks the isolated Investments module, safe simulated Questrade states, live read-only authorization transport, encrypted persistence, action intents, local Host policy, outbound host allowlist, and HTTP/WebSocket boundaries.",
      "capabilities": ["investments-questrade-stage-1", "investments-questrade-stage-2"]
    },
    "investments-client": {
      "label": "Investments Connected Accounts UI",
      "command": "npm",
      "args": ["--prefix", "client", "test", "--", "src/api/investments.test.js", "src/components/connected-accounts/ConnectedAccountCard.test.jsx", "src/components/SettingsAccountsSection.test.jsx", "src/components/investments/QuestradeConnectedAccount.test.jsx"],
      "cwd": ".",
      "timeoutMs": 120000,
      "why": "Checks the provider-neutral account frame and every safe simulated Questrade state without live services.",
      "capabilities": ["investments-questrade-stage-1", "investments-questrade-stage-2"]
    },
    "investments-boundary": {
      "label": "Investments module ownership boundaries",
      "command": "node",
      "args": ["server/scripts/run-tests.js", "--continue", "test/investments/module-boundaries.test.js"],
      "resultContract": "server-tests",
      "cwd": ".",
      "timeoutMs": 30000,
      "why": "Prevents Investments and QBO teams from importing each other's internals and proves module registration has no lifecycle side effects.",
      "capabilities": ["investments-questrade-stage-1", "investments-questrade-stage-2"]
    },
    "investments-browser": {
      "label": "Rendered Investments desktop and mobile journey",
      "command": "node",
      "args": ["scripts/investments-browser-acceptance.js"],
      "cwd": ".",
      "timeoutMs": 120000,
      "why": "Uses the already-running user-owned app to check the live disconnected/token-entry boundary plus safe Stage 2 desktop, mobile, keyboard, reduced-motion, recovery, revocation, overflow, console, and no-live-Questrade-network states; if the app is unavailable, reports an explicit incomplete result without starting or stopping services.",
      "capabilities": ["investments-questrade-stage-1", "investments-questrade-stage-2"]
    },
    "client-build": {
      "label": "Production client build and bundle canary",
      "command": "npm",
      "args": ["run", "test:client-bundle"],
      "cwd": ".",
      "timeoutMs": 180000,
      "environment": "production",
      "why": "Catches production-only build and bundle regressions.",
      "capabilities": ["qbo-evidence-intake", "saved-session-resume"]
    },
    "qbo-client": {
      "label": "Critical QBO client tests",
      "command": "npm",
      "args": ["--prefix", "client", "test", "--", "src/lib/unsavedWorkGuard.test.js", "src/hooks/useAppRouteState.test.jsx", "src/components/chat-v5/UnsavedResultNotice.test.jsx", "src/components/chat-v5/EvidenceSummary.test.jsx", "src/components/chat-v5/useStageOrchestrator.test.jsx", "src/components/chat-v5/ChatV5Container.test.jsx", "src/components/EscalationDashboard.test.jsx", "src/components/EscalationDetail.test.jsx", "src/components/KnowledgebaseView.test.jsx"],
      "cwd": ".",
      "timeoutMs": 120000,
      "why": "Runs the fast checks closest to the critical QBO workflow.",
      "capabilities": ["qbo-evidence-intake", "image-parse-validation", "qbo-orchestration", "conversation-persistence", "unsaved-result-protection", "saved-session-resume", "evidence-completeness", "escalation-lifecycle"]
    },
    "qbo-stress-slices": {
      "label": "Critical QBO isolated stress slices",
      "command": "node",
      "args": ["stress-testing/scripts/run-slices.js", "escalation-domain", "image-intake-and-parse", "main-chat", "client-surfaces"],
      "resultContract": "stress-slices",
      "cwd": ".",
      "timeoutMs": 1800000,
      "why": "Exercises QBO server wiring and selected real-browser behavior with synthetic data.",
      "requirements": ["agent-browser"],
      "capabilities": ["qbo-evidence-intake", "image-parse-validation", "qbo-orchestration", "conversation-persistence", "unsaved-result-protection", "saved-session-resume", "evidence-completeness", "escalation-lifecycle"]
    },
    "all-stress-slices": {
      "label": "All nine isolated stress slices",
      "command": "node",
      "args": ["stress-testing/scripts/run-slices.js"],
      "resultContract": "stress-slices",
      "cwd": ".",
      "timeoutMs": 3600000,
      "why": "Runs every registered isolated slice, including real-browser canaries.",
      "requirements": ["agent-browser"],
      "capabilities": ["qbo-evidence-intake", "image-parse-validation", "qbo-orchestration", "conversation-persistence", "unsaved-result-protection", "saved-session-resume", "evidence-completeness", "escalation-lifecycle", "workspace-primary-operations-agent"]
    },
    "testing-map": {
      "label": "Testing capability map validation",
      "command": "node",
      "args": ["scripts/validate-testing-map.js"],
      "cwd": ".",
      "timeoutMs": 30000,
      "why": "Keeps known evidence and testing gaps honest.",
      "capabilities": ["evidence-completeness"]
    }
  },
  "profiles": {
    "core": ["client-components", "server-suite", "stress-harness-tests", "runner-contracts", "dev-startup", "investments-boundary", "testing-map"],
    "focused-qbo": ["client-components", "server-suite", "stress-harness-tests", "runner-contracts", "dev-startup", "qbo-stress-slices", "testing-map"],
    "investments": ["investments-server", "investments-client", "investments-boundary", "dev-startup", "investments-browser", "testing-map"],
    "full": ["client-components", "server-suite", "stress-harness-tests", "runner-contracts", "dev-startup", "client-build", "all-stress-slices", "testing-map"]
  }
}
